# ============================================================
#  Настройки Exam Trainer
#  Заполни OPENAI_API_KEY — остальное по желанию.
# ============================================================

# --- LLM-экзаменатор (обязательно) ---

# Ключ OpenAI-совместимого API.
OPENAI_API_KEY=

# Адрес прокси/шлюза, если используешь не официальный OpenAI.
# Оставь пустым для api.openai.com. Пример: https://мой.прокси/v1
OPENAI_BASE_URL=

# Модель, которая проверяет ответ. По умолчанию gpt-4o-mini.
OPENAI_MODEL=

# --- Распознавание речи (необязательно) ---

# Токен HuggingFace. НЕ обязателен: модели Whisper (Systran/faster-whisper-*)
# публичные и скачиваются без авторизации. Токен лишь повышает лимиты запросов
# и ускоряет загрузку — HF показывает предупреждение об этом при скачивании.
# Читается автоматически библиотекой huggingface_hub, в коде не используется.
# Получить: https://huggingface.co/settings/tokens (права: read)
HF_TOKEN=

# Путь к аудиофайлу по умолчанию — чтобы не вводить его каждый раз.
# Пример: C:\Users\Имя\Documents\Аудиозаписи\Запись.m4a
EXAM_AUDIO=
